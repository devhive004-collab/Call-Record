<?xml version="1.0" encoding="utf-8"?><!--
    Auto Backup (API 31+ uses data_extraction_rules.xml; below uses this file).
    Recordings audio lives in app-specific external Music/Sajil (not backed up
    by default) while the Room DB is. A restore can therefore yield rows whose
    file is missing — RecordingRepository.cleanupMissingFiles() drops those on
    startup so history never shows unplayable corpses. Deliberately no <include>
    of audio here: backing up hours of m4a to the 25MB cloud quota would fail.
-->
<full-backup-content>
    <!--
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
